# Gourmet Distri - site vitrine (gourmetdistri.fr)
# Deploye automatiquement par OVH depuis GitHub (Euphorique91/site-vitrine, branche main).
# Depot PUBLIC : ne jamais y mettre de mot de passe, de cle ou de jeton.

Options -Indexes
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml .webmanifest .svg
ErrorDocument 404 /404.html
DirectoryIndex index.html

# Ne jamais servir les fichiers internes du depot
RedirectMatch 404 ^/\.git
RedirectMatch 404 ^/README\.md$

RewriteEngine On
# Adresse unique https://gourmetdistri.fr (HTTPS, sans www) : evite le contenu en double pour Google
RewriteCond %{HTTP_HOST} ^www\.gourmetdistri\.fr$ [NC]
RewriteRule ^ https://gourmetdistri.fr%{REQUEST_URI} [L,R=301]
RewriteCond %{SERVER_PORT} 80
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^ https://gourmetdistri.fr%{REQUEST_URI} [L,R=301]
# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# Types de fichiers
AddType font/woff .woff
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico

# Compression (pages, styles, dessins SVG)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>

# Mise en cache dans le navigateur
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Securite
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=15552000"
  <FilesMatch "\.(woff)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------
# QR codes dynamiques
# Pour changer la page d'arrivee d'un QR code : modifier l'adresse en fin
# de ligne, puis pousser sur GitHub. Le QR code imprime ne change jamais.
# 302 = redirection temporaire : les telephones ne la memorisent pas.
# utm_source = support scanne (pour les statistiques).
# ------------------------------------------------------------------
RedirectMatch 302 ^/qr/camion/?$  https://gourmetdistri.fr/?utm_source=camion&utm_medium=qrcode&utm_campaign=qr
RedirectMatch 302 ^/qr/carte/?$   https://gourmetdistri.fr/?utm_source=carte-de-visite&utm_medium=qrcode&utm_campaign=qr
RedirectMatch 302 ^/qr/colis/?$   https://gourmetdistri.fr/?utm_source=colis&utm_medium=qrcode&utm_campaign=qr

# Supports a definir : renommer la valeur utm_source le jour ou ils sont attribues
RedirectMatch 302 ^/qr/s1/?$      https://gourmetdistri.fr/?utm_source=a-definir-1&utm_medium=qrcode&utm_campaign=qr
RedirectMatch 302 ^/qr/s2/?$      https://gourmetdistri.fr/?utm_source=a-definir-2&utm_medium=qrcode&utm_campaign=qr
RedirectMatch 302 ^/qr/s3/?$      https://gourmetdistri.fr/?utm_source=a-definir-3&utm_medium=qrcode&utm_campaign=qr

# QR code general (premier modele, sans support precis)
RedirectMatch 302 ^/qr/?$         https://gourmetdistri.fr/?utm_source=general&utm_medium=qrcode&utm_campaign=qr
